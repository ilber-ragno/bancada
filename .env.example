# Copie para .env e preencha. Nunca faça commit do .env.

# Endereço do painel. Mantenha 127.0.0.1 e acesse por VPN, Tailscale ou túnel SSH.
HOST=127.0.0.1
PORT=8787

# Chave do cofre (segredos de MCP, chaves dos autenticadores e do push).
# Gere com: openssl rand -hex 32   — guarde fora do servidor também; sem ela os segredos não podem ser lidos.
BANCADA_SECRET_KEY=

# Use 1 quando o painel estiver atrás de HTTPS (obrigatório para push no celular)
COOKIE_SECURE=0

# Pasta onde ficam estado, conversas, contas e auditoria
DATA_DIR=data

# Autenticação SSH: por padrão usa o ssh-agent da máquina (SSH_AUTH_SOCK).
SSH_KEY_PATH=
SSH_KEY_PASSPHRASE=

# Servidor usado para ler o consumo dos planos (/usage e /status). Ex.: deploy@10.0.1.20
USAGE_HOST=
USAGE_INTERVAL_MIN=10

# Telegram: o token do bot fica só aqui. Cada pessoa informa o próprio chat no perfil.
TELEGRAM_BOT_TOKEN=
# Canal geral do time (opcional)
TELEGRAM_CHAT_ID=

# Webhook (n8n, Make, Slack...). Só https.
WEBHOOK_URL=

# Contato usado no push (Web Push)
PUSH_SUBJECT=mailto:ti@suaempresa.com.br

# Endereços que o Portal pode abrir dentro da Bancada (Content-Security-Policy frame-src)
PORTAL_FRAME_SRC=https: http://localhost:* http://127.0.0.1:*
